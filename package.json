{
  "name": "kamery",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild web/app.jsx --bundle --minify --jsx=automatic --format=esm --target=chrome116 --external:/video-rtc.js --outfile=.runtime/app.js",
