    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
